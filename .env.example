# Vertex AI region (default: global). Other valid values: us-central1, asia-southeast1, etc.
GOOGLE_CLOUD_LOCATION=global

# Primary Gemini model. Ditto falls back to gemini-2.5-flash, gemini-2.5-flash-lite, gemini-1.5-flash if unavailable.
GEMINI_MODEL=gemini-3.1-pro

# Optional. Wall-clock budget per agent run (ms). Default: 300000 (5 min).
# DITTO_BUDGET_MS=300000

# Optional. Disable colors.
# NO_COLOR=1
